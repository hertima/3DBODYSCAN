# Firebase Configurations
VITE_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:000000000000000000000000
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# OpenAI Configurations (For AI Coach features)
OPENAI_API_KEY=your_openai_api_key_here

# Firebase API Key server-side (mesma chave que VITE_FIREBASE_API_KEY, sem prefixo VITE_)
# Usada pelo server-auth.ts para verificar tokens Firebase nos endpoints /api/*
FIREBASE_API_KEY=your_firebase_api_key_here

# VAPID — Web Push Notifications (gere em: https://web-push-codelab.glitch.me/)
# A chave pública vai para o frontend; a privada fica APENAS no servidor (.env local, nunca no git)
VITE_VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here
