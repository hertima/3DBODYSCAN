// 3D Body Scanner — Firestore Security Rules
// version: 4
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Bloqueio padrão — nada acessível salvo o explicitamente permitido abaixo
    match /{document=**} {
      allow read, write: if false;
    }

    // Regra única: cobre data/, localState/, workouts/, customizations/,
    // notifications/, bodyScanHistory/, foodScanHistory/ e qualquer
    // subcoleção futura dentro de users/{uid}/
    match /users/{userId}/{document=**} {
      allow read, write: if
        request.auth != null &&
        request.auth.uid == userId;
    }
  }
}
